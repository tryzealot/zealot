#!/bin/sh

cd /app

# The cached lease is usually fresher than the env seed, but either can be the
# valid one after an outage. For the same license, pick whichever expires later;
# if the env seed points at another license, ignore the old lease. The gem proxy
# rejects expired tokens, so choosing blindly can break a restart.
#
# The payload is decoded with String#unpack instead of the base64 gem: the image
# installs gems into vendor/bundle, so a bare `ruby -rbase64` would not find it.
token_field() {
  ruby -rjson -e '
    parts = ARGV[0].to_s.split(".")
    exit 1 unless parts.length == 3
    encoded = parts[1].tr("-_", "+/")
    encoded += "=" * ((4 - encoded.length % 4) % 4)
    payload = JSON.parse(encoded.unpack1("m0"))
    puts payload[ARGV[1]].to_i
  ' "$1" "$2" 2>/dev/null || echo 0
}

# The script is the only writer of the zealot-pro line in /app/Gemfile. Drop it
# before every decision so a changed gateway cannot leave a stale source or a
# duplicate entry behind. The match is anchored to column 0 and to the exact
# gem name followed by a comma, so an indented or commented-out line owned by
# someone else is never touched.
drop_pro_gem_line() {
  sed -i "/^gem 'zealot-pro',/d" /app/Gemfile
}

ZEALOT_PRO_STATE_DIR="${ZEALOT_PRO_STATE_DIR:-/app/storage/zealot_pro}"
LICENSE_TOKEN="$ZEALOT_PRO_LICENSE"
if [ -f "$ZEALOT_PRO_STATE_DIR/license_token" ]; then
  CACHED_LICENSE_TOKEN=$(cat "$ZEALOT_PRO_STATE_DIR/license_token")
  if [ -n "$CACHED_LICENSE_TOKEN" ]; then
    CACHED_LICENSE_ID=$(token_field "$CACHED_LICENSE_TOKEN" license_id)
    ENV_LICENSE_ID=$(token_field "$ZEALOT_PRO_LICENSE" license_id)
    CACHED_EXP=$(token_field "$CACHED_LICENSE_TOKEN" exp)
    ENV_EXP=$(token_field "$ZEALOT_PRO_LICENSE" exp)

    # Same license: take the later expiry. Different licenses: never use the
    # old lease, because the operator replaced the seed for a reason.
    if [ "$CACHED_LICENSE_ID" -gt 0 ] && [ "$CACHED_LICENSE_ID" = "$ENV_LICENSE_ID" ] && [ "$CACHED_EXP" -ge "$ENV_EXP" ]; then
      LICENSE_TOKEN="$CACHED_LICENSE_TOKEN"
    elif [ "$CACHED_LICENSE_ID" -gt 0 ] && [ "$ENV_LICENSE_ID" -eq 0 ] && [ "$CACHED_EXP" -gt 0 ]; then
      LICENSE_TOKEN="$CACHED_LICENSE_TOKEN"
    fi
  fi
fi

if [ -n "$LICENSE_TOKEN" ]; then
  echo "[Zealot Pro] Detected a license token, installing zealot-pro gem via bundle..."

  # Resolve the gem source from the same override the license client uses.
  # Production stays the default so existing deployments are unchanged.
  GATEWAY_URL="${ZEALOT_PRO_GATEWAY_URL:-https://gateway.ews.im}"
  GATEWAY_URL=$(printf '%s' "$GATEWAY_URL" | sed 's#/*$##')
  GEM_SOURCE="$GATEWAY_URL/gems"
  PRO_GEM_LINE="gem 'zealot-pro', '~> 0.2', source: '$GEM_SOURCE'"

  echo "[Zealot Pro] Gem source: $GEM_SOURCE"

  # 1. Only touch the Gemfile when the source answers. The proxy requires a
  #    license, so a 401 still proves the host is reachable; a transport
  #    failure reports 000. A missing curl is not a reachability verdict: log
  #    it and let bundle install decide.
  reachable=false
  if ! command -v curl >/dev/null 2>&1; then
    echo "[Zealot Pro] WARNING: curl is not installed, skipping the reachability probe for $GEM_SOURCE."
    reachable=true
  else
    http_code=$(curl -s -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 10 "$GEM_SOURCE" 2>/dev/null)
    curl_status=$?
    if [ "$curl_status" -ne 0 ] || [ -z "$http_code" ] || [ "$http_code" = "000" ]; then
      echo "[Zealot Pro] WARNING: $GEM_SOURCE is unreachable (curl exit $curl_status, HTTP code ${http_code:-none}), skipping zealot-pro install."
    else
      reachable=true
    fi
  fi

  if [ "$reachable" != true ]; then
    # Never leave the Gemfile pointing at a dead source.
    drop_pro_gem_line
  else
    # Replace any line left by an earlier boot: a changed gateway must not
    # leave a stale source or a duplicate entry behind.
    drop_pro_gem_line
    echo "$PRO_GEM_LINE" >> /app/Gemfile

    # 2. Temporarily lift the image's deployment/frozen locks.
    bundle config unset --local deployment 2>/dev/null || true
    bundle config unset --local frozen 2>/dev/null || true
    bundle config unset --global frozen 2>/dev/null || true

    # 3. Inject the gateway Basic Auth credentials for the resolved source.
    #    `bundle config set --global` is the authoritative lookup. The env key
    #    is only a fallback for a read-only HOME: Bundler checks the full
    #    source URL first, then the bare host, and only the host form is
    #    stable here (the URL form needs a trailing slash). Dots become "__"
    #    and hyphens "___" in env keys.
    gateway_host="${GATEWAY_URL#*://}"
    gateway_host="${gateway_host%%/*}"
    gateway_host="${gateway_host%%:*}"
    credential_env=$(printf '%s' "$gateway_host" | tr '[:lower:]' '[:upper:]' | sed 's/\./__/g; s/-/___/g')
    export "BUNDLE_${credential_env}=license:${LICENSE_TOKEN}"
    bundle config set --global "$GEM_SOURCE" "license:$LICENSE_TOKEN"

    # 4. Install, and roll the Gemfile back if the source answered but the
    #    install still failed, so the next boot starts from a clean file.
    bundle config set without 'development test'
    if bundle install --retry 2; then
      echo "[Zealot Pro] zealot-pro installed successfully via bundle."
    else
      echo "[Zealot Pro] WARNING: bundle install failed, removing zealot-pro from Gemfile."
      drop_pro_gem_line
    fi
  fi
fi

exec ./bin/rails zealot:upgrade
