- if resource.errors.any?
  .d-alert.d-alert-error.mb-4 data-turbo-cache="false"
    i.fa-solid.fa-circle-xmark.text-lg
    div
      .font-bold = t('errors.messages.not_saved', count: resource.errors.count, resource: resource.class.model_name.human.downcase)
      ul.list-disc.list-inside.text-sm
        - resource.errors.full_messages.each do |message|
          li = message