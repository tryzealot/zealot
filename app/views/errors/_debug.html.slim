- if Rails.env.development?
  .card.card-secondary.card-outline
    .card-header
      h3.card-title
        i.fa-solid.fa-bug
        = "#{@exception.class}: #{@exception.message}"
        small.d-badge.d-badge-secondary.ml-2 = t('errors.messages.development_only')
    .card-body.p-0
      table.d-table
        - @exception.backtrace.each do |link|
          tr
            td = link
