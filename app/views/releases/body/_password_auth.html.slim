.card.mt-30
  .card-header
    h3.card-title = t('releases.show.enter_password')

  .card-body
    - if @error_message.present?
      .my-2.d-alert.d-alert-error.flex.items-center.gap-2
        i.fa-solid.fa-triangle-exclamation
        span = @error_message

    = form_with url: auth_channel_release_path(@channel, @release), method: :post do |form|
      .d-join class="w-full"
        span.d-join-item.d-btn.d-btn-square.d-btn-ghost
          i.fa-solid.fa-key
        = form.password_field :password, placeholder: '******', class: 'd-input rounded-l-none d-join-item w-full'
        button.d-join-item.d-btn.d-btn-secondary type="submit"
          i.fa-solid.fa-arrow-right
      = form.hidden_field :back_url, value: params[:back_url]
