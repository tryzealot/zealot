= turbo_frame_tag metadata, class: 'flex flex-col gap-2 py-2 px-3 text-sm font-semibold border-b border-base-300 sm:grid sm:grid-cols-12 sm:items-center' do 
  div class="col-span-12 sm:col-span-4 flex justify-between items-center sm:block" 
    .flex.flex-col.gap-1.truncate
      = link_to (metadata.name || '-'), teardown_path_for(metadata, app: @app), data: { turbo_frame: '_top' }
      - if metadata.release_version.present?
        span.text-xs.opacity-75
          = metadata.release_version
          - if metadata.build_version.present?
            |  (#{metadata.build_version})
    .block.sm:hidden
      == render 'teardowns/actions', metadata: metadata, manage_role: manage_role

  div class="flex items-center justify-between sm:contents"
    div class="col-span-6 sm:col-span-2 truncate text-xs sm:text-sm" 
      = platform_name(metadata.platform)
    div class="col-span-6 sm:col-span-2 text-xs opacity-65 text-right sm:text-left"
      = metadata.user&.username || t('teardowns.index.anonymous')

  div class="hidden sm:block sm:col-span-3 text-xs opacity-65 d-tooltip" data-tip=l(metadata.created_at, format: :nice)
    = time_ago_in_words(metadata.created_at)

  div class="hidden sm:flex sm:col-span-1 justify-end"
    == render 'teardowns/actions', metadata: metadata, manage_role: manage_role
