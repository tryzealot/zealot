= turbo_stream.remove :empty_scheme
/ = turbo_stream.append :schemes, partial: 'apps/scheme', locals: { scheme: @scheme, app: @app }
= turbo_stream.replace :schemes, partial: 'apps/schemes', locals: { app: @app }

= turbo_stream.append :notifications, partial: 'layouts/notifications'
= turbo_stream.remove :empty_scheme
= turbo_stream.append dom_id(@app, :schemes), partial: 'apps/scheme', locals: { app: @app, scheme: @scheme }

/ - @app.schemes.each do |scheme|
/   - if scheme != @scheme
/     = turbo_stream.replace dom_id(scheme, :app), partial: 'apps/scheme', locals: { app: @app, scheme: scheme }
