.card
  .card-header
    h3.card-title
      i class="fa-solid fa-filter"
      = t('apps.show.filters.title')

  .card-body class="space-y-3"
    = form_with url: app_path(@app), method: :get, class: 'space-y-3' do |f|
      div
        label class="d-label" for="scheme_id" = t('apps.show.filters.scheme')
        = select_tag :scheme_id,
          options_for_select(@schemes.map { |s| [s.name, s.id] }, params[:scheme_id]),
          include_blank: t('apps.show.filters.all_schemes'),
          class: 'd-select d-select-bordered w-full',
          onchange: 'this.form.requestSubmit()'

      div
        label class="d-label" for="channel_id" = t('apps.show.filters.channel')
        = select_tag :channel_id,
          options_for_select(@channels.map { |c| [channel_platform(c), c.id] }, params[:channel_id]),
          include_blank: t('apps.show.filters.all_channels'),
          class: 'd-select d-select-bordered w-full',
          onchange: 'this.form.requestSubmit()'

      .flex.justify-end
        = link_to t('apps.show.filters.reset'), app_path(@app), class: 'd-btn d-btn-ghost d-btn-sm'
