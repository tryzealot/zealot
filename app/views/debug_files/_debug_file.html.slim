ruby:
  version = debug_file_version(debug_file)
  debug_file_path = app_debug_file_path(app, debug_file)

li id=dom_id(debug_file) class="d-list-row flex items-center gap-4 hover:bg-base-200"
  / Flex instead of the list row's grid: the grid sizes the text column to its
  / content and leaves the rest of the row empty.
  div class="min-w-0 flex-1"
    div class="flex items-center gap-2"
      span class="min-w-0 truncate text-base font-bold" title=version = version
      - if debug_file.processing?
        small class="d-badge d-badge-sm d-badge-warning flex-shrink-0" = t('debug_files.index.processing')
      - elsif debug_file.parse_failed?
        small class="d-badge d-badge-sm d-badge-error flex-shrink-0" = t('debug_files.index.parse_failed')

    div class="mt-1 flex flex-wrap items-center gap-x-2 text-xs text-base-content/60 sm:text-sm"
      span class="whitespace-nowrap"
        = t('debug_files.index.uploaded_at', time: time_ago_in_words(debug_file.created_at))
      - if debug_file.filesize.present?
        span class="text-base-content/30" = '·'
        span class="whitespace-nowrap" = number_to_human_size(debug_file.filesize)
      - if debug_file.parse_failed?
        span class="text-base-content/30" = '·'
        span class="min-w-0 truncate text-error" title=debug_file.parse_error = debug_file.parse_error
      - elsif !debug_file.processing?
        - if ios_debug_file?(debug_file)
          span class="text-base-content/30" = '·'
          span class="whitespace-nowrap" = t('debug_files.index.libraries_count', count: debug_file.libraries.count)
        - elsif debug_file.proguard_files.present?
          span class="text-base-content/30" = '·'
          span class="whitespace-nowrap" = t('debug_files.index.files_count', count: debug_file.proguard_files.count)

  div class="flex-shrink-0 text-base-content/40"
    i.fa-solid.fa-chevron-right

  / Stretched link: the entire row opens the file, not just the title.
  = link_to debug_file_path, class: 'absolute inset-0 z-10 rounded-box focus-visible:ring-2 focus-visible:ring-primary' do
    span.sr-only = version
