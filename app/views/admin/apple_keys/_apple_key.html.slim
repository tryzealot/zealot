== turbo_frame_tag apple_key, class: 'flex flex-col gap-2 py-2 px-3 text-sm font-semibold border-b border-base-300 sm:grid sm:grid-cols-12 sm:items-center' do 
  div class="hidden sm:block sm:col-span-1" 
    = apple_key.id
  div class="col-span-12 sm:col-span-5 md:col-span-5 flex justify-between items-center sm:block"
    span.truncate
      = link_to apple_key.team.full_name, admin_apple_key_path(apple_key), data: { turbo_frame: '_top' }
    .block.sm:hidden
      == render 'admin/apple_keys/actions', apple_key: apple_key
  div class="flex items-center justify-between sm:contents"
    div class="text-xs sm:text-sm text-base-content/70 sm:col-span-3 md:col-span-3"
      = apple_key.team.team_id
    div class="text-xs opacity-65 d-tooltip sm:col-span-2 md:col-span-2" data-tip=l(apple_key.created_at, format: :nice)
      = time_ago_in_words(apple_key.created_at)
  div class="hidden sm:flex sm:col-span-1 justify-end"
    == render 'admin/apple_keys/actions', apple_key: apple_key
