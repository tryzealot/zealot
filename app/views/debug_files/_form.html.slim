= simple_form_for([@app, @debug_file], html: { class: 'card'}) do |f|
  .card-header
    h3.card-title = @title
  .card-body
    = f.error_notification

    = f.input :device_type, collection: DebugFile.device_types, label_method: :last, value_method: :first, include_blank: false
    = f.input :release_version, hint: t('debug_files.form.release_version_hint')
    = f.input :build_version, hint: t('debug_files.form.build_version_hint')
    = f.input :file, required: true
    - if @debug_file.errors[:checksum].present?
      = f.input :checksum, disabled: true
  .card-footer
    = f.button :submit
