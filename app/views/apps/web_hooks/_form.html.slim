ruby:
  channels = Channel.where(id: app.channel_ids).order(:id)

= simple_form_for [app, web_hook], data: { action: 'turbo:submit-end->modal#close' } do |f|
  = f.error_notification

  div class="grid grid-cols-1 md:grid-cols-2 gap-4"
    div
      = f.input :url, required: true
      = f.input :body, as: :text, input_html: { rows: 10, cols: 10 }

    div
      = f.input :channel_ids, collection: channels, as: :check_boxes, \
        label_method: :channel_name, value_method: :id, include_hidden: false, \
        label: t('simple_form.labels.web_hook.channels'), \
        input_html: { class: 'd-checkbox d-checkbox-primary' }

    div class="md:col-span-2"
      fieldset class="d-fieldset mb-2"
        p class="d-fieldset-legend" = t('simple_form.labels.web_hook.events')
        div class="flex flex-wrap items-center gap-x-6 gap-y-2"
          = f.input_field :upload_events, as: :boolean, class: 'd-toggle d-toggle-primary mr-2'
          = f.label :upload_events, class: 'text-md font-semibold cursor-pointer'
          = f.input_field :download_events, as: :boolean, class: 'd-toggle d-toggle-primary mr-2'
          = f.label :download_events, class: 'text-md font-semibold cursor-pointer'
          = f.input_field :changelog_events, as: :boolean, class: 'd-toggle d-toggle-primary mr-2'
          = f.label :changelog_events, class: 'text-md font-semibold cursor-pointer'

  div class="mt-3"
    = f.button :submit
