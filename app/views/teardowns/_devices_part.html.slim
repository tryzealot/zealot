- if devices.present?
  .card
    .card-header
      h3.card-title
        = t('teardowns.show.devise_list', count: devices.size)
    .card-body.p-0.overflow-x-auto
      table.d-table
        - devices.sort.each do |udid|
          tr
            td.flex.justify-between.items-center.gap-2
              span.break-all = udid
              - if (device = Device.find_by(udid: udid)) && device.name.present?
                small.d-badge.d-badge-ghost.shrink-0
                  = device.name
