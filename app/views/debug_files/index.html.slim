- content_for :title do
  = app_scoped_title(@app, @title)

- content_for :section_title do
  = @title

- content_for :section_rightpanel do
  - if current_user&.manage?(app: @app)
    = button_link_to t('debug_files.index.upload'), new_app_debug_file_path(@app), 'plus-square', \
      base_fa: 'fa-regular', class: 'd-btn-success d-tooltip d-tooltip-left', \
      data: { tip: t('debug_files.index.upload') }

.grid class="gap-4 grid-cols-1 xl:grid-cols-2"
  == render 'platform', platform: 'android', type: 'proguard', files: @proguard_files, page_param: :proguard_page
  == render 'platform', platform: 'ios', type: 'dsym', files: @dsym_files, page_param: :dsym_page
