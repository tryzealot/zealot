- if @web_hooks.size == 1
  = turbo_stream.update :web_hooks_container, partial: 'apps/web_hooks/table', locals: { web_hooks: @web_hooks, app: @app }
- else
  = turbo_stream.append :web_hooks, partial: 'apps/web_hooks/web_hook', locals: { web_hook: @web_hook, app: @app }

= turbo_stream.append :notifications, partial: 'layouts/notifications'
