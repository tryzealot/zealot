.card
  .card-body class="p-0"
    div class="hidden sm:grid sm:grid-cols-12 gap-2 py-2 px-3 text-sm font-semibold opacity-65 border-b border-base-300"
      div class="col-span-4" = t('web_hooks.table.url')
      div class="col-span-3" = t('web_hooks.table.events')
      div class="col-span-3" = t('web_hooks.table.channels')
      div class="col-span-2"
    #web_hooks
      - web_hooks.each do |web_hook|
        == render 'apps/web_hooks/web_hook', web_hook: web_hook, app: app
