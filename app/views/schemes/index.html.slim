- content_for :title do
  = @title

- content_for :section_title do
  = "#{@app.name} · #{@title}"

- content_for :section_rightpanel do
  - if @app.archived
    small class="d-badge d-badge-sm d-badge-warning py-1"
      = t('apps.sidebar.archived')
  - elsif current_user&.manage?(app: @app)
    = button_link_to t('apps.show.new_scheme'), new_app_scheme_path(@app), 'plus-square', \
      base_fa: 'fa-regular', \
      class: 'd-btn d-btn-success', \
      data: { turbo_frame: :modal }

- schemes_total = @schemes.size

#schemes class="#{app_scheme_columns(schemes_total)} gap-4 mb-4 items-start *:break-inside-avoid"
  - if schemes_total.positive?
    - @schemes.each do |scheme|
      == render 'apps/scheme', scheme: scheme, app: @app
  - else
    == render 'apps/empty_scheme', app: @app
